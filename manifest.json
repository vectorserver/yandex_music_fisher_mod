{
  "manifest_version": 3,
  "name": "Yandex Music Fisher mod by vectorserver",
  "version": "2.1.42",
  "description": "Скачивание музыки с сервисов Яндекс.Музыка и Яндекс.Радио",
  "icons": {
    "128": "icons/music_by_pancaza.png"
  },
  "action": {
    "default_icon": "icons/music_by_pancaza.png",
    "default_popup": "html/popup.html",
    "default_title": "Yandex Music Fisher mod by vectorserver"
  },
  "background": {
    "service_worker": "js/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://api.music.yandex.ru/*",
        "https://*.strm.yandex.net/*",
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.by/*",
        "https://music.yandex.uz/*",
        "https://yastatic.net/*"
      ],
      "js": ["js/content.js"]
    }
  ],
  "permissions": [
    "tabs",
    "downloads",
    "webRequest",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://*.music.yandex.ru/*",
    "https://*.storage.yandex.net/*",
    "https://*.strm.yandex.net/*"
  ],
  "incognito": "split",
  "options_page": "html/options.html",
  "homepage_url": "https://github.com/vectorserver/yandex_music_fisher_mod",
  "update_url": "https://github.com/vectorserver/yandex_music_fisher_mod/update/"
}
