{
  "manifest_version": 3,
  "name": "Yandex Music Fisher mod by vectorserver",
  "version": "3.0.0",
  "description": "Скачивание музыки с Яндекс.Музыки: ID3-теги, история, докачка и умная очередь. Yandex Music Fisher mod by vectorserver",
  "icons": {
    "128": "icons/music_by_pancaza.png"
  },
  "action": {
    "default_icon": "icons/music_by_pancaza.png",
    "default_popup": "html/popup.html",
    "default_title": "Yandex Music Fisher mod by vectorserver"
  },
  "background": {
    "scripts": ["js/service_worker.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.by/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "tabs",
    "downloads",
    "scripting",
    "storage",
    "alarms",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://music.yandex.kz/*",
    "https://music.yandex.by/*",
    "https://music.yandex.uz/*",
    "https://api.music.yandex.ru/*",
    "https://*.strm.yandex.net/*",
    "https://*.storage.yandex.net/*",
    "https://*.yandex.net/*"
  ],
  "incognito": "split",
  "options_page": "html/options.html",
  "homepage_url": "https://vk.com/vectorserver",
  "browser_specific_settings": {
    "gecko": {
      "id": "yandex-music-fisher@vectorserver",
      "strict_min_version": "115.0"
    }
  }
}
